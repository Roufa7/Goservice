{
    "name": "goservice/v3",
    "description": "GoService merged platform",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "willdurand/geocoder": "^4.3",
        "php-http/curl-client": "^2.0",
        "nyholm/psr7": "^1.4",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.1",
        "eluceo/ical": "^0.16",
        "phpmailer/phpmailer": "^7.0",
        "openai-php/client": "^0.19.2",
        "guzzlehttp/guzzle": "^7.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "classmap": ["model/", "controller/", "service/"],
        "files": ["config.php"]
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.12"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
